# Flask Environment (development or production)
FLASK_ENV=development

# Immutable release image tags for production compose. Use a version or Git SHA,
# not latest/local. scripts/check_release_images.py enforces this for updates.
WEBHDP_IMAGE_TAG=0.1.0-alpha.4
WEBHDP_BACKEND_IMAGE=webhdp-backend:0.1.0-alpha.4
WEBHDP_FRONTEND_IMAGE=webhdp-frontend:0.1.0-alpha.4
WEBHDP_FAST_RENDERER_IMAGE=webhdp-fast-renderer:0.1.0-alpha.4
WEBHDP_ANY_TO_USDZ_IMAGE=webhdp-any-to-usdz:0.1.0-alpha.4
# The converter defaults to the official AMD64 Blender runtime because native
# Debian ARM64 Blender builds can miss USD export support. Docker Desktop on
# Apple Silicon runs this service through emulation. Override only after a deep
# converter test passes on the target platform.
ANY_TO_USDZ_PLATFORM=linux/amd64

# SQLite remains the default deployment database. Override only when needed.
DATABASE_URL=sqlite:////app/instance/hdp_web.db

# SECRET KEY - Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# REQUIRED in production!
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# Optional setup bootstrap. Generate with: openssl rand -hex 32
# Required if you want to run setup endpoints before the first admin exists.
SETUP_BOOTSTRAP_TOKEN=

# Optional first-run admin creation during container bootstrap.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Standard native WebHDP deployments do not require HDP-Server fallback settings.
# Archived legacy fallback examples are documented separately in:
# docs/guides/hdp_server_integration_guide.md

# Deployment mode controls whether computational HDP components may run locally.
# Default server/VPS deployments stay conservative and require HPC-Link for
# renderer/USDZ conversion when those steps are enabled.
WEBHDP_DEPLOYMENT_MODE=server
WEBHDP_ALLOW_LOCAL_HDP_COMPONENTS=false
# Workstation-local Docker installs on a capable Mac/workstation/lab PC may opt
# in to local compute containers:
# WEBHDP_DEPLOYMENT_MODE=local
# WEBHDP_ALLOW_LOCAL_HDP_COMPONENTS=true
# COMPOSE_PROFILES=local-hdp-components
# WEBHDP_LOCAL_COMPONENT_IMAGE_ALLOWLIST=ghcr.io/hdp-components/*,webhdp-*
# WEBHDP_REQUIRE_PINNED_LOCAL_COMPONENT_IMAGES=false
# Optional curated remote component indexes. Entries may point to Git/Zenodo
# metadata and immutable Docker/SIF artifacts; leave empty to use only the
# bundled local external_code catalog.
WEBHDP_COMPONENT_INDEX_SOURCES=
WEBHDP_COMPONENT_INDEX_TIMEOUT_SECONDS=15
WEBHDP_COMPONENT_INDEX_CACHE_TTL_SECONDS=900
# unknown allows all configured entries for local testing. Production deployments
# should usually require community-reviewed or trusted.
WEBHDP_COMPONENT_INDEX_MIN_TRUST=unknown
# Do not use this opt-in for a small VPS/simple server; use HPC-Link instead.
COMPOSE_PROFILES=

# HPC-Link allocation fallback. Leave sequence empty in the repository example;
# real deployment partition names belong only in the deployed .env.
HPC_LINK_PARTITION_SEQUENCE=
HPC_LINK_PARTITION_ATTEMPT_TIMEOUT_SECONDS=300
# Admission limits apply to WebHDP accounts before sending a job to HPC-Link.
HPC_LINK_MAX_QUEUED_ALLOCATIONS_PER_USER=2
HPC_LINK_MAX_QUEUED_ALLOCATIONS=24
HPC_LINK_QUEUED_REQUEST_TTL_MINUTES=1440
HPC_LINK_MAX_GPUS_PER_ALLOCATION=4
HPC_LINK_MAX_DURATION_MINUTES_PER_ALLOCATION=10080

# Optional: Whitelist allowed upload directories (comma-separated)
# ALLOWED_UPLOAD_DIRECTORIES=/home/user/uploads,/var/data/uploads

# Upload/storage capacity guardrails. Keep this aligned with frontend/nginx.conf.
MAX_CONTENT_LENGTH=53687091200
ACCOUNT_UPLOAD_STORAGE_BYTES=53687091200
ACCOUNT_UPLOAD_MAX_ACTIVE=3
ACCOUNT_UPLOAD_STREAM_DAILY_BYTES=53687091200
WEBHDP_NATIVE_PROCESSING_ACTIVE_LIMIT=3
MIN_UPLOAD_FREE_BYTES=5368709120
MIN_UPLOAD_FREE_MULTIPLIER=1.5

# Session artifact cleanup is separate from browser/JWT session expiry.
# Leave disabled unless backups/exports/retention policy are operational.
SESSION_ARTIFACT_CLEANUP_ENABLED=false
SESSION_ARTIFACT_RETENTION_SECONDS=2592000
SESSION_CLEANUP_INTERVAL_SECONDS=300
ENABLE_FLASK_SESSION_CLEANUP=false

# Maintenance flag used by scripts/pre_update.sh and middleware.
MAINTENANCE_MODE=false
MAINTENANCE_FLAG_PATH=

# Count only the proxies that append the client address before the private API.
# Compose defaults to one proxy. Direct API installations should use zero.
# AUTH_TRUSTED_PROXY_HOPS=1
# AUTH_THROTTLE_DB_PATH=/app/instance/auth-throttle.sqlite3

# --- Mail Server Configuration ---
# Replace these with your actual SMTP provider details
MAIL_SERVER=smtp.your-provider.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@heritage-data.org
MAIL_TIMEOUT=5

# --- Optional login MFA ---
# Development-only helper for local Docker/test setups without SMTP. When
# FLASK_ENV is not production and this is set to inline, login responses include
# the one-time MFA code and the login screen displays it. Production ignores it.
MFA_DEVELOPMENT_CODE_DELIVERY=inline
MFA_EMAIL_CODE_LENGTH=6
MFA_EMAIL_CODE_TTL_SECONDS=600
MFA_EMAIL_MAX_VERIFY_ATTEMPTS=5
MFA_EMAIL_RESEND_COOLDOWN_SECONDS=60
MFA_RECOVERY_CODE_COUNT=10
MFA_RECOVERY_CODE_LENGTH=12
MFA_ADMIN_RECOVERY_CODE_TTL_SECONDS=86400
MFA_RECOVERY_RATE_LIMIT_ATTEMPTS=5
MFA_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=300
MFA_RECOVERY_RATE_LIMIT_LOCKOUT_SECONDS=900

# --- Notification tuning for low-resource VPS deployments ---
NOTIFICATION_POLL_INTERVAL_SECONDS=120
NOTIFICATION_DROPDOWN_LIMIT=10
NOTIFICATION_PAGE_LIMIT=50
NOTIFICATION_DIGEST_MAX_PER_USER=10
NOTIFICATION_DIGEST_USER_BATCH_SIZE=25
NOTIFICATION_DELIVERY_AUDIT_RETENTION_DAYS=90
NOTIFICATION_READ_RETENTION_DAYS=180
NOTIFICATION_ARCHIVED_RETENTION_DAYS=90
NOTIFICATION_SSE_ENABLED=false

# --- Zenodo Configuration ---
ZENODO_SANDBOX_API_KEY=
ZENODO_API_KEY=
# Optional site-wide Sandbox credential for regular publishing workflows.
# Ordinary accounts cannot use the site-wide Production credential.
WEBHDP_ALLOW_SYSTEM_SANDBOX_PUBLISHING=false

# --- Local EDM Validator ---
# Run https://github.com/Digital-Humanities-Jena/local-edm-validator locally and
# point WebHDP at its REST API. Use host.docker.internal when WebHDP runs in
# Docker and the validator stack runs on the host. The managed Compose overlay
# overrides this to http://local-edm-validator:8080 inside the Docker network.
LOCAL_EDM_VALIDATOR_URL=http://host.docker.internal:18080
ENABLE_LOCAL_EDM_VALIDATION=true
LOCAL_EDM_VALIDATOR_REQUIRED=true
LOCAL_EDM_VALIDATOR_CONTINUE_ON_ERROR=true
EMIT_EUROPEANA_3D_ADVISORY_FIELDS=false
# Optional Docker Compose overlay support:
# make local-edm-validator-setup
# docker compose -f docker-compose.yml -f docker-compose.edm-validator.yml up --build
LOCAL_EDM_VALIDATOR_REPO=./external_code/local-edm-validator
LOCAL_EDM_VALIDATOR_SOURCE_REPOSITORY=https://github.com/Digital-Humanities-Jena/local-edm-validator.git
LOCAL_EDM_VALIDATOR_SOURCE_REF=b1ba67802ae1581c88ba8ea0ae9740cf663a0176
LOCAL_EDM_VALIDATOR_IMAGE=local-edm-validator:webhdp-b1ba67802ae1
LOCAL_EDM_VALIDATOR_PORT=18080

# --- Optional Dropbox Configuration ---
# For server deployments that should store browser-uploaded source artifacts in
# Dropbox, set STORAGE_MODE=pure_cloud and provide the Dropbox OAuth values.
# Use cloud_backup only when the server is intentionally allowed to retain a
# local copy in addition to Dropbox; use local only for HPC/local filesystem
# scan workflows.
STORAGE_MODE=pure_cloud
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- Frontend Configuration ---
# This URL is used to generate the email verification links.
# In production, use your actual domain (e.g., https://hdp.your-domain.com)
FRONTEND_URL=http://localhost
WEBHDP_HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
OEMBED_FRAME_ANCESTORS='self'

# Optional public legal-page metadata for institutional deployments. Use | to
# separate address lines. These values are compiled into frontend builds.
VITE_LEGAL_PROVIDER_NAME=Example Research Institution
VITE_LEGAL_PROVIDER_ADDRESS=Example Street 1|12345 Example City|Country
VITE_LEGAL_PROVIDER_REPRESENTATIVE=its authorized representative
VITE_LEGAL_SUPERVISORY_AUTHORITY_NAME=Competent supervisory authority
VITE_LEGAL_SUPERVISORY_AUTHORITY_ADDRESS=Authority address configured by the operator
VITE_LEGAL_VAT_ID=configured by the operator
VITE_LEGAL_PROJECT_CONTACT_NAME=WebHDP project team
VITE_LEGAL_PROJECT_CONTACT_ADDRESS=Project contact address configured by the operator
VITE_LEGAL_PROJECT_CONTACT_EMAIL=webhdp@3drepo.eu
VITE_LEGAL_DPO_EMAIL=privacy@example.org
VITE_LEGAL_DPO_LABEL=data protection officer
VITE_LEGAL_COMPLAINT_AUTHORITY_NAME=the competent data protection supervisory authority
VITE_LEGAL_COMPLAINT_AUTHORITY_ADDRESS=Supervisory authority address configured by the operator

# Absolute path to your Google Cloud service-account JSON on the host machine.
# Do not commit credentials into this repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json

# --- Local Volumes Configuration (referenced in docker-compose.yml) ---
WEBHDP_SESSIONS_PATH=./hdp-shared/sessions
WEBHDP_INSTANCE_PATH=./instance
LOCAL_INPUT_HOST_PATH=./local_input
LOCAL_OUTPUT_HOST_PATH=./local_output
CREDENTIALS_HOST_PATH=./credentials

# --- Operational Backups ---
# For local development, use provider=local. For deployment, use provider=dropbox
# with BACKUP_ENCRYPTION_KEY set. Cloud backups are refused unless encrypted.
WEBHDP_INSTANCE_ID=webhdp-local
BACKUP_ENABLED=false
BACKUP_PROVIDER=local
BACKUP_LOCAL_DIR=./backups
BACKUP_REMOTE_PREFIX=/WebHDP/backups
BACKUP_INCLUDE_CREDENTIALS=true
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_SECONDS=93600
# Optional scheduled backup shell helper settings.
BACKUP_TYPE=scheduled
BACKUP_PRUNE_PROVIDER=local
BACKUP_RESTORE_DRILL=true
UPDATE_DRAIN_TIMEOUT_SECONDS=900

# --- Optional HPC Link Configuration ---
HPC_LINK_API_KEY=
HPC_LINK_BASE_URL=

# Restrict this deployment to the verified render/metadata workflows and HPC diagnostics.
WEBHDP_CORE_ONLY=false
# In core mode, enable the native Tools with their usual account and runtime checks.
WEBHDP_ENABLE_NATIVE_TOOLS=false
# Disable all record publication for staging and teaching test deployments.
ZENODO_PUBLISH_ENABLED=true
# Optional invited HPC-Link service user. Tokens are renewed automatically.
# Credentials are only used with the exact HPC_LINK_BASE_URL above.
HPC_LINK_USERNAME=
HPC_LINK_PASSWORD=

# WebHDP-Link application integration. Start scripts/webhdp_link_worker.py with
# the same database and persistent storage as the API. FRONTEND_URL identifies
# the consent and hosted progress pages; this value is the public API origin/base
# WITHOUT /api/v1/link (set explicitly behind a reverse proxy).
WEBHDP_LINK_PUBLIC_BASE_URL=
# Empty uses <instance>/webhdp-link. API and Link workers must share this path.
WEBHDP_LINK_STORAGE_PATH=
WEBHDP_LINK_MAX_CONCURRENT_RUNS=2
