# Stage 1: Build Vue App
FROM node:22-alpine AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_LEGAL_PROVIDER_NAME
ARG VITE_LEGAL_PROVIDER_ADDRESS
ARG VITE_LEGAL_PROVIDER_REPRESENTATIVE
ARG VITE_LEGAL_SUPERVISORY_AUTHORITY_NAME
ARG VITE_LEGAL_SUPERVISORY_AUTHORITY_ADDRESS
ARG VITE_LEGAL_VAT_ID
ARG VITE_LEGAL_PROJECT_CONTACT_NAME
ARG VITE_LEGAL_PROJECT_CONTACT_ADDRESS
ARG VITE_LEGAL_PROJECT_CONTACT_EMAIL
ARG VITE_LEGAL_DPO_EMAIL
ARG VITE_LEGAL_DPO_LABEL
ARG VITE_LEGAL_COMPLAINT_AUTHORITY_NAME
ARG VITE_LEGAL_COMPLAINT_AUTHORITY_ADDRESS
ENV VITE_LEGAL_PROVIDER_NAME=${VITE_LEGAL_PROVIDER_NAME}
ENV VITE_LEGAL_PROVIDER_ADDRESS=${VITE_LEGAL_PROVIDER_ADDRESS}
ENV VITE_LEGAL_PROVIDER_REPRESENTATIVE=${VITE_LEGAL_PROVIDER_REPRESENTATIVE}
ENV VITE_LEGAL_SUPERVISORY_AUTHORITY_NAME=${VITE_LEGAL_SUPERVISORY_AUTHORITY_NAME}
ENV VITE_LEGAL_SUPERVISORY_AUTHORITY_ADDRESS=${VITE_LEGAL_SUPERVISORY_AUTHORITY_ADDRESS}
ENV VITE_LEGAL_VAT_ID=${VITE_LEGAL_VAT_ID}
ENV VITE_LEGAL_PROJECT_CONTACT_NAME=${VITE_LEGAL_PROJECT_CONTACT_NAME}
ENV VITE_LEGAL_PROJECT_CONTACT_ADDRESS=${VITE_LEGAL_PROJECT_CONTACT_ADDRESS}
ENV VITE_LEGAL_PROJECT_CONTACT_EMAIL=${VITE_LEGAL_PROJECT_CONTACT_EMAIL}
ENV VITE_LEGAL_DPO_EMAIL=${VITE_LEGAL_DPO_EMAIL}
ENV VITE_LEGAL_DPO_LABEL=${VITE_LEGAL_DPO_LABEL}
ENV VITE_LEGAL_COMPLAINT_AUTHORITY_NAME=${VITE_LEGAL_COMPLAINT_AUTHORITY_NAME}
ENV VITE_LEGAL_COMPLAINT_AUTHORITY_ADDRESS=${VITE_LEGAL_COMPLAINT_AUTHORITY_ADDRESS}
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:stable-alpine AS production-stage
COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template
ENV OEMBED_FRAME_ANCESTORS="'self'"
ENV NGINX_CLIENT_MAX_BODY_SIZE="50G"
RUN chmod -R a+rX /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
