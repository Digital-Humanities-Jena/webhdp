# Stage 1: Build Vue app with same-origin API base.
FROM node:22-alpine AS build-stage
WORKDIR /app

ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=${VITE_API_URL}

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Serve static frontend with nginx and proxy /api -> backend on HPC host network.
FROM nginx:stable-alpine AS production-stage

COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY nginx.hpc.singularity.conf.template /etc/nginx/templates/default.conf.template
RUN chmod 644 /etc/nginx/templates/default.conf.template

# Default ports used by Singularity runtime script; can be overridden via env.
ENV FRONTEND_PORT=8080
ENV BACKEND_PORT=5500
ENV OEMBED_FRAME_ANCESTORS="'self'"

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
