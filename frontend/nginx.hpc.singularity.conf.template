# OAuth callback parameters, authorization headers and old verification links are excluded from access logs.
map $uri $webhdp_logged_uri {
    ~^/verify-email/                 /verify-email/[redacted];
    ~^/api/v1/auth/verify-email/     /api/v1/auth/verify-email/[redacted];
    default                         $uri;
}
log_format webhdp_safe '$remote_addr $request_method $webhdp_logged_uri $status $body_bytes_sent $request_time';

server {
    listen       ${FRONTEND_PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;
    access_log /var/log/nginx/access.log webhdp_safe;

    # Keep large uploads possible through the frontend reverse proxy.
    client_max_body_size 50G;

    # Protect application consent/admin pages; public embed location overrides.
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    location ^~ /embed/records/ {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors ${OEMBED_FRAME_ANCESTORS}; img-src 'self' data: blob: https://zenodo.org https://sandbox.zenodo.org; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://zenodo.org https://sandbox.zenodo.org; form-action 'self'" always;
        try_files $uri $uri/ /index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Link owns its exact-origin authorization and preflight responses. Never
    # strip Origin or handle its OPTIONS in the legacy generic API location.
    location ^~ /api/v1/link/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
        proxy_request_buffering off;
        proxy_read_timeout 1200s;
        proxy_connect_timeout 1200s;
        proxy_send_timeout 1200s;
        client_max_body_size 50G;
    }

    location /api {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin "";

        proxy_read_timeout 1200s;
        proxy_connect_timeout 1200s;
        proxy_send_timeout 1200s;
        client_max_body_size 50G;
    }
}
