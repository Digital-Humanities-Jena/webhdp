  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:core": "playwright test auth.spec.ts workflow.spec.ts workflow-usability.spec.ts workflow-guidance.spec.ts resume-and-access.spec.ts workflow-transition-recovery.spec.ts lod-recovery.spec.ts component-constructor-reliability.spec.ts operation-recovery.spec.ts",
    "test:e2e:backend": "WEBHDP_BROWSER_TESTING=1 playwright test --config playwright.backend.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.16.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.10.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "@google/model-viewer": "^4.2.0",
    "@heroicons/vue": "^2.2.0",
    "axios": "^1.21.1",
    "codemirror": "^6.0.1",
    "dompurify": "^3.4.18",
    "marked": "^17.0.1",
    "mermaid": "^12.3.0",
    "pinia": "^3.0.4",
    "three": "0.182.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^29.0.1",
    "msw": "^2.13.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "js-beautify": {
      "editorconfig": "^4.0.1",
      "glob": "^14.0.6"
    }
  }
