{
  "@context": "http://iiif.io/api/presentation/4/context.json",
  "id": "{{ Zenodo url + path to manifest.json }}",
  "type": "Manifest",
  "label": { "en": ["{{ Title }}"] },
  "summary": { "en": ["{{ Description }}"] },
  "items": [
    {
      "id": "https://example.org/iiif/scene1/page/p1/1",
      "type": "Scene",
      "label": { "en": ["A Scene"] },
      "items": [
        {
          "id": "https://example.org/iiif/scene1/page/p1/1",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://example.org/iiif/3d/anno1",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "type": "SpecificResource",
                "source": [
                  {
					"id": "{{ Zenodo url + Filename }}",
                    "type": "Model",
                    "format": "model/gltf-binary"
                  }
                ],
                "transform": [
                  {
                    "type": "TranslateTransform",
                    "x": 0.0,
                    "y": 0.0,
                    "z": 0.0
                  },
                  {
                    "type": "RotateTransform",
                    "x": 0,
                    "y": 0,
                    "z": 0
                  },
                  {
                    "type": "ScaleTransform",
                    "x": 1,
                    "y": 1,
                    "z": 1
                  }
                ]
              },
              "target": {
                "type": "SpecificResource",
                "source": [
                  {
                    "id": "https://example.org/iiif/scene1/page/p1/1",
                    "type": "Scene"
                  }
                ],
                "selector": [
                  {
                    "type": "GeoPointSelector",
                    "latitude": {{ Latitude }},
                    "longitude": {{ Longitude }},
					"altitude": {{ Orthometric Height }},
                    "heading": {{ Heading Angle }}
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
