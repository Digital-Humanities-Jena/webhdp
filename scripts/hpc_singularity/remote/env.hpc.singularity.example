FLASK_ENV=production
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# WebHDP app
BACKEND_PORT=5500
FAST_RENDERER_PORT=5502
ANY_TO_USDZ_PORT=5503
REDIS_PORT=6380
FRONTEND_IN_SINGULARITY=false
FRONTEND_PORT=8080

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:////app/instance/hdp_web.db
DEFAULT_ADMIN_EMAIL=admin@webhdp.local
DEFAULT_ADMIN_PASSWORD=
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
CREDENTIAL_ENCRYPTION_KEY=

# Persistence / storage
WEBHDP_SESSIONS_PATH=/home/webhdp-user/webhdp/hdp-shared/sessions
SHARED_SESSION_PATH=/home/webhdp-user/webhdp/hdp-shared/sessions
STORAGE_MODE=local
WEBHDP_DEPLOYMENT_MODE=local
WEBHDP_ALLOW_LOCAL_HDP_COMPONENTS=true
LOCAL_INPUT_PATH=/data/local_input
LOCAL_OUTPUT_PATH=/data/local_output

# Services
FAST_RENDERER_URL=http://127.0.0.1:5502
ANY_TO_USDZ_URL=http://127.0.0.1:5503
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/0
# Set to true only for tiny single-process/non-Docker verification installs.
# Production deployments should run Redis and a Celery worker.
WEBHDP_INLINE_TASKS=false
CELERY_WORKER_CONCURRENCY=2
WEBHDP_SERVICE_WATCHDOG_INTERVAL_SECONDS=300
ENABLE_RENDERER=true
ENABLE_USDZ_CONVERSION=true
ENABLE_RENDERER_NV=true
LOAD_CUDA_ENV=true
REQUIRE_GPU=true

# Local EDM validation stack for production publishing tests.
# Keep these false for a lightweight side-by-side smoke/test deployment when
# another important WebHDP job is already running on the same cluster account.
ENABLE_LOCAL_EDM_VALIDATION=true
LOCAL_EDM_VALIDATOR_CONTINUE_ON_ERROR=false
ENABLE_LOCAL_EDM_VALIDATOR_STACK=true
LOCAL_EDM_VALIDATOR_REQUIRED=true
LOCAL_EDM_VALIDATOR_URL=http://127.0.0.1:18080
LOCAL_EDM_VALIDATOR_PORT=18080
LOCAL_EDM_XSLT_PORT=18081
LOCAL_EDM_POSTGRES_PORT=5432
LOCAL_EDM_MONGO_PORT=27017
LOCAL_EDM_SOLR_PORT=8983
LOCAL_EDM_SOLR_ZK_PORT=9983
LOCAL_EDM_MINIO_PORT=9000
LOCAL_EDM_MINIO_CONSOLE_PORT=9001
# The stack serves the pinned Europeana stylesheets locally by default.
LOCAL_EDM_XSLT_URL=http://127.0.0.1:18081/default-edm-sorter.xsl
LOCAL_EDM_TRANSFORMATION_URL=http://127.0.0.1:18081/default_transformation.xslt
LOCAL_EDM_FFMPEG_BIN_DIR=/home/webhdp-user/webhdp/tools/ffmpeg-8/bin
LOCAL_EDM_VALIDATOR_APP_JAR=/home/webhdp-user/webhdp/tools/local-edm-validator/app.jar

# Optional external integrations
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-credentials.json
ZENODO_SANDBOX_API_KEY=
ZENODO_API_KEY=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
SHARED_GDRIVE_FOLDER_ID=

# Mail
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=noreply@webhdp.local
