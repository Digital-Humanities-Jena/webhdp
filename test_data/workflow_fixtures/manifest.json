        "bundle_members": {
          "site042_structure_detail.obj": [
            "site042_structure_detail.obj",
            "site042_structure_detail.mtl",
            "site042_structure_main.fbx"
          ],
          "site093_artifact_fragment.obj": [
            "site093_artifact_fragment.obj",
            "site093_artifact_fragment.mtl",
            "site093_artifact_complete.fbx"
          ]
        },
        "statuses": {}
      }
    },
