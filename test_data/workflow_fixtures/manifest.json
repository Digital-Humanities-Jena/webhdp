{
  "version": 1,
  "description": "Curated synthetic WebHDP workflow fixtures for scanner, bundling, and golden workflow tests.",
  "cases": [
    {
      "id": "root_stem_mixed",
      "description": "Root mode stem bundling with one OBJ/MTL/image bundle, one FBX, and one real GLB.",
      "path": "cases/root_stem_mixed",
      "negative_case": false,
      "scan_options": {
        "extensions": [
          ".obj",
          ".mtl",
          ".jpg",
          ".fbx",
          ".glb"
        ],
        "primarysourceext": ".obj",
        "preferred_primary_files": [
          "temple_column.obj",
          "ceramic_bowl.fbx",
          "bronze_helmet.glb"
        ],
        "bundling": {
          "enabled": true,
          "strategy": "stem_match"
        },
        "batchEntity": "root",
        "obj_options": {
          "add_mtl": true,
          "add_textures": true,
          "archive_subdirectories": false
        }
      },
      "expected": {
        "record_count": 3,
        "primary_sources": [
          "bronze_helmet.glb",
          "ceramic_bowl.fbx",
          "temple_column.obj"
        ],
        "bundle_members": {
          "temple_column.obj": [
            "temple_column.obj",
            "temple_column.mtl",
            "temple_column.jpg"
          ],
          "ceramic_bowl.fbx": [
            "ceramic_bowl.fbx"
          ],
          "bronze_helmet.glb": [
            "bronze_helmet.glb"
          ]
        },
        "statuses": {
          "temple_column.obj": "Valid",
          "temple_column.mtl": "Valid",
          "temple_column.jpg": "Valid",
          "ceramic_bowl.fbx": "Valid",
          "bronze_helmet.glb": "Valid"
        }
      }
    },
    {
      "id": "root_pattern_locations",
      "description": "Root mode regex pattern grouping into Athens and Rome bundles with texture scanning disabled.",
      "path": "cases/root_pattern_locations",
      "negative_case": false,
      "scan_options": {
        "extensions": [
          ".obj",
          ".mtl"
        ],
        "primarysourceext": ".obj",
        "preferred_primary_files": [
          "Athens_Temple_Section_A.obj",
          "Rome_Forum_Column_01.obj"
        ],
        "bundling": {
          "enabled": true,
          "strategy": "pattern",
          "pattern": "^([A-Za-z]+)_"
        },
        "batchEntity": "root",
        "obj_options": {
          "add_mtl": true,
          "add_textures": false,
          "archive_subdirectories": false
        }
      },
      "expected": {
        "record_count": 2,
        "primary_sources": [
          "Athens_Temple_Section_A.obj",
          "Rome_Forum_Column_01.obj"
        ],
        "bundle_members": {
          "Athens_Temple_Section_A.obj": [
            "Athens_Temple_Section_A.obj",
            "Athens_Temple_Section_B.obj",
            "Athens_Temple_materials.mtl"
          ],
          "Rome_Forum_Column_01.obj": [
            "Rome_Forum_Column_01.obj",
            "Rome_Forum_Column_02.obj",
            "Rome_Forum_materials.mtl"
          ]
        },
        "statuses": {
          "Athens_Temple_Section_B.obj": "MTL Missing",
          "Rome_Forum_Column_02.obj": "MTL Missing"
        }
      }
    },
    {
      "id": "root_prefix_suffix_literal",
      "description": "Root mode literal prefix and suffix removal that matches current scanner behavior.",
      "path": "cases/root_prefix_suffix_literal",
      "negative_case": false,
      "scan_options": {
        "extensions": [
          ".obj",
          ".mtl"
        ],
        "primarysourceext": ".obj",
        "bundling": {
          "enabled": true,
          "strategy": "prefix_suffix",
          "prefix": "scan_",
          "suffix": "_raw"
        },
        "batchEntity": "root",
        "obj_options": {
          "add_mtl": true,
          "add_textures": false,
          "archive_subdirectories": false
        }
      },
      "expected": {
        "record_count": 1,
        "primary_sources": [
          "scan_pottery_fragment_raw.obj"
        ],
        "bundle_members": {
          "scan_pottery_fragment_raw.obj": [
            "scan_pottery_fragment_raw.obj",
            "pottery_fragment.mtl"
          ]
        },
        "statuses": {}
      }
    },
    {
      "id": "core_identifier_via_pattern",
      "description": "Core identifier behavior represented by regex pattern grouping for site IDs.",
      "path": "cases/core_identifier_via_pattern",
      "negative_case": false,
      "scan_options": {
        "extensions": [
          ".obj",
          ".mtl",
          ".fbx"
